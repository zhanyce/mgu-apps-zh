      "statusACFront": "rs",
      "statusACFrontFunctions": "rs",
      "statusAirConditionDRStatus": "rs",
      "statusActualValuePowerACCompressor": "rs"
    },
    "de.bmw.infotainment.climate.climatemaster.ClimateMaster": {
      "_optional": "HVAC system on/off, A/C button, and target temperature setpoint",
      "statusClimateSystemOn": "rs",
      "statusAirCondAC": "rs",
      "statusAirCondMaxAC": "rs",
      "statusTemperature": "rs"
    },
    "de.bmw.dass.GapVehicleAhead": {
      "_optional": "radar/camera lead vehicle distance, headway, and relative speed",
      "GapVehicleDrivingAhead": "s",
      "DataFrontVehicle": "s",
      "DataFrontVehicleExtended": "s"
    },
