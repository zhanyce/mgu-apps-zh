      "playerMetadata": "rs",
      "mainMenuMetadata": "rs",
      "trackProgress": "rs",
      "coverArt": "rs"
    },
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": {
      "_optional": "CarPlay media play/pause state and metadata fallback",
      "_instances": "CarPlayMedia",
      "currentItemMetadata": "rs",
      "currentItemTime": "rs",
      "playerState": "rs"
    },
    "de.bmw.body.Light": {
      "_optional": "left steering-column stalk BC button click detection",
      "IndicatorSteeringColumn": "s",
      "IndicatorSteeringColumnComplete": "s",
      "StatusFunctionsIndicators": "s"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "_optional": "tire pressures, temperatures and targets for smart alerts",
      "statusTyreTemperature": "rs",
      "statusTyrePressure": "rs",
      "statusTargetTyrePressure": "rs"
    },
    "de.bmw.infotainment.climate.Climate2": {
      "_optional": "interior cabin temperature and HVAC cooling/heating/fan state",
