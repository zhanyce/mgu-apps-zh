      "nextIntersection": "rs",
      "finalDestinationInfo": "rs",
      "nextDestinationInfo": "rs"
    },
    "de.bmw.infotainment.navigation.guiding.GuidanceEventList": {
      "_optional": "read turn-by-turn maneuvers for HUD navigation re-rendering",
      "_instances": "Main_Instance",
      "_methods": [
        "queryContent"
      ]
    },
    "de.bmw.infotainment.navigation.guiding.GuidanceRenderedContent": {
      "_optional": "first-party HUD intersection mini-map / 3D junction view state (HIGH_GUIDING / JUNCTION_VIEW / CITY_HIGHWAY_MAP)",
      "_instances": "Main_Instance",
      "registeredViews": "rs",
      "_methods": [
        "getViewConfig",
        "getViewContent"
      ],
      "_broadcasts": [
        "viewContentChanged"
      ]
    },
    "de.bmw.infotainment.navigation.projectedmodeguiding.ProjectedModeGuiding": {
      "_optional": "detect CarPlay / Baidu / Android Auto lane guidance & arrival waypoints",
      "_instances": "Main_Instance",
      "currentLaneGuiding": "rs",
      "waypoints": "rs"
    },
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": {
