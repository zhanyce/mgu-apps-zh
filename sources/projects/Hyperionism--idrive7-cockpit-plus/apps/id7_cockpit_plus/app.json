    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s",
      "UnitBN2020": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "_optional": "trip consumption, fuel & electric range, BC selection, local clock, and electrical power distribution",
      "statusRangeTankStatus": "rs",
      "displayRangeElectricVehicle": "rs",
      "statusBordcomputerAverage": "rs",
      "statusBordcomputerTravelData": "rs",
      "statusBordcomputerElectricData": "rs",
      "statusKombiSelection": "rs",
      "statusDisplayElectricalPowerDistribution": "rs",
      "statusShowTimeDate": "rs",
      "timeDateUTC": "rs"
    },
    "com.harman.infotainment.systeminfrastructure.autotime.autotime.AutoTime": {
      "_optional": "head-unit local clock and timezone offset for charging finish time",
      "_instances": "Inst1",
      "current": "rs"
    },
    "de.bmw.infotainment.hmi.hmicontext.HMIContext": {
      "_optional": "active CID HMI timezone enum fallback for charging finish time",
      "_instances": "HMI_CID",
      "currentTimeZone": "rs"
    },
    "de.bmw.infotainment.hmi.hmimediastate.HmiMediaState": {
      "_optional": "active media title, artist, playback position, and JPEG/PNG album art across CarPlay/Bluetooth/USB/Radio",
