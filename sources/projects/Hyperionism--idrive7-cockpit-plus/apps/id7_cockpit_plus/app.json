{
  "id": "id7_cockpit_plus",
  "title": "Cockpit+",
  "description": "Cockpit+ for BMW iDrive 7 (KOMBI4 + HUD): calibrated KOMBI4 bezel SDF FullView with 340/7 halo & custom fade width, symmetric Center Small Map (0x203), Pure Stock 0x100+0x200 mode, smooth BC card cycling, raised 5AU turn card & ETA pill, and bold HUD navigation",
  "version": "0.9.15",
  "autostart": true,
  "license": "GPL-3.0-only",
  "vendor": "idrive7-cockpit-plus",
  "vendorFiles": {
    "cluster_render_client.js": "apps/redline/cluster_render_client.js",
    "redline_hud_nav.js": "apps/redline/hud-nav.js",
    "redline_nav.js": "apps/redline/nav.js"
  },
  "bundleNotices": [
    "Cockpit+ (id7_cockpit_plus) - GNU General Public License v3.0 (GPL-3.0, see LICENSE).",
    "Built upon chyiz/idrive7-cluster-plus (GPL-3.0) with Cockpit+ 5AU lane guidance, iOS turn card, ETA pill, and adjustable layout.",
    "",
    "Bundled runtime dependencies retain their upstream licenses:",
    "- kit/*, redline_hud_nav.js, redline_nav.js: MIT License (cauliflowermossgrape/idrive7-apps)",
    "- cluster_render_client.js: MPL-2.0, Copyright (C) 2026 Robert Nisipeanu",
    "- jpeg_decoder.js (jpeg-js 0.4.4): Apache-2.0 / BSD-3-Clause",
    "- kit/fonts/{bold,gear,label,light,num}.json: Ubuntu Font Licence 1.0 (LICENSE-UbuntuFont.txt)",
    "- latin_auto.pack, kit/fonts/cjk.json & cjk_gothic.pack: Noto Sans & Noto Sans CJK (SC/JP/TC/KR), SIL Open Font License 1.1 (LICENSE-NotoSansCJK.txt)"
  ],
  "repoTitle": "GitHub Repository",
  "repoLink": "github.com/Hyperionism/idrive7-cockpit-plus",
  "loggingId": "OA7C",
  "iconGlyph": "id7_cockpit_plus",
  "mguHmi": ["ID7"],
  "requires": {
    "cluster-render": "2.9.6",
