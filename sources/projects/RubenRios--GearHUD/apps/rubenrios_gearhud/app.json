{
  "id": "rubenrios_gearhud",
  "title": "GearHUD",
  "description": "La marcha engranada (D3, S4, M2) en el HUD, en el cuadro o en los dos, con el color que quieras y otro para S y M",
  "version": "1.0.0",
  "vendor": "rubenrios",
  "loggingId": "OGH1",
  "iconGlyph": "D3",
  "_comment_signals": "Todas opcionales: en un coche cuyo catálogo no tenga una interfaz, el instalador la quita en vez de abortar (kit/missing-interfaces.json). Sin la marcha del cambio, se estima con rpm y velocidad.",
  "signals": {
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s",
      "_optional": "la marcha que envía el cambio: sin ella se estima con las rpm y la velocidad"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "dataDisplayGearbox": "s",
      "_optional": "el programa S / M de la palanca: sin él se muestra siempre D"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "_optional": "el modo de conducción: sin él el cuadro usa siempre la posición normal de la D"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "VehicleCondition": "s",
      "_optional": "si el coche está listo: sin él no se sabe cuándo se enciende o se apaga"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "_optional": "la velocidad: sin ella no se estima la marcha ni se calibra"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "_optional": "las rpm: sin ellas no se estima la marcha"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusDayNightChangeOver": "rs",
      "_optional": "día o noche: sin él no se usa el brillo de noche"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "GearHUD",
      "buttons": [
        ["BTN_CALIB", "Calibrar"],
        ["BTN_RELOAD", "Recargar posición"],
        ["BTN_SETTINGS", "Ajustes"]
      ]
    }
  ],
  "settings": [
    { "key": "show", "label": "Dónde mostrar la marcha", "type": "choice", "default": "off",
      "options": [["off", "En ningún sitio (solo registrar)"], ["hud", "HUD"], ["cluster", "Cuadro"], ["both", "HUD y cuadro"]] },

    { "key": "hudColour", "label": "Color en el HUD", "type": "choice", "default": "softgrey",
      "options": [["white", "Blanco"], ["softgrey", "Gris suave"], ["grey", "Gris"], ["warm", "Blanco cálido"], ["amber", "Ámbar"],
                  ["orange", "Naranja"], ["mred", "Rojo M"], ["ice", "Azul hielo"], ["mblue", "Azul M"], ["green", "Verde"], ["custom", "Personalizado"]] },
    { "key": "hudStyle", "label": "Qué se ve en el HUD", "type": "choice", "default": "full",
      "options": [["full", "Letra y marcha (D3)"], ["digit", "Solo la marcha (3)"]] },
    { "key": "hudPRN", "label": "En P, R y N", "type": "choice", "default": "letter",
      "options": [["letter", "Mostrar la letra"], ["hide", "No mostrar nada"]] },
    { "key": "hudPos", "label": "Posición en el HUD", "type": "choice", "default": "right",
      "options": [["top", "Arriba, centrada"], ["left", "A la izquierda"], ["right", "A la derecha"],
                  ["lowLeft", "Abajo a la izquierda"], ["lowRight", "Abajo a la derecha"]] },
