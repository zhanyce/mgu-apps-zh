      "steps": [100, 80, 70, 60, 50, 40, 30, 20] },
    { "key": "hudGiveWay", "label": "Dejar el HUD a Redline u otra app que lo use", "type": "bool", "default": true },

    { "key": "modeColours", "label": "Distinguir S y M por el color", "type": "choice", "default": "all",
